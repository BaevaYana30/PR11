
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Добавить пластинку — VINYL STORE</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<header class="header">
    <div class="logo">
        <span class="logo-title">VINYL STORE</span>
        <span class="logo-subtitle">✦ РАРИТЕТНЫЙ АНАЛОГОВЫЙ ЗВУК ✦</span>
    </div>

    <nav class="nav">
        <a href="/" class="cart-btn">Вернуться в магазин</a>
        <form action="/logout" method="POST">
            <button type="submit" class="cart-btn">Выйти</button>
        </form>
    </nav>
</header>

<main class="catalog">
    <div class="section-header">
        <h2 class="genre-title">ДОБАВИТЬ ПЛАСТИНКУ</h2>
        <div class="divider-line"></div>
    </div>

    <div class="modal-window" style="max-width: 600px; margin: 30px auto; padding: 30px;">
        <form action="/add" method="POST" class="checkout-form">

            <div class="form-group">
                <label>Название альбома</label>
                <input type="text" name="title" placeholder="Например, Thriller" required>
            </div>

            <div class="form-group">
                <label>Исполнитель</label>
                <input type="text" name="artist" placeholder="Например, Michael Jackson" required>
            </div>

            <div class="form-group">
                <label>Год выпуска</label>
                <input type="number" name="year" min="1" required>
            </div>

            <div class="form-group">
                <label>Цена (тг)</label>
                <input type="number" name="price" min="0" required>
            </div>

            <div class="form-group">
                <label>Состояние пластинки</label>
                <input type="text" name="condition" placeholder="Например, NM / EX">
            </div>

            <div class="form-group">
                <label>Жанр</label>
                <input type="text" name="genre" placeholder="Например, Rock" required>
            </div>

            <% if (error) { %>
                <p style="color: red;"><%= error %></p>
            <% } %>

            <button type="submit" class="btn-primary">
                Добавить пластинку
            </button>

        </form>
    </div>
</main>

</body>
</html>
