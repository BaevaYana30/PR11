<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VINYL STORE — Раритетные виниловые пластинки</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">

    <script src="/turntable-hero.js" defer></script>

    <style>
        .admin-actions {
            display: flex !important;
            gap: 10px;
            margin-top: 15px;
            width: 100%;
        }

        .admin-edit,
        .admin-delete {
            display: block;
            flex: 1;
            padding: 12px 8px;
            border: none;
            border-radius: 6px;
            font-family: Montserrat, sans-serif;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .admin-edit {
            background: #d4a65a;
            color: #171717;
        }

        .admin-delete {
            background: #a83232;
            color: white;
        }

        .admin-edit:hover,
        .admin-delete:hover {
            opacity: 0.85;
        }

        #edit-modal {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(0, 0, 0, 0.85);
            align-items: center;
            justify-content: center;
            overflow-y: auto;
            padding: 20px;
            box-sizing: border-box;
        }

        #edit-modal .modal-window {
            max-width: 500px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            background: #202020;
            color: white;
            border-radius: 12px;
            padding: 25px;
            box-sizing: border-box;
        }

        .edit-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 20px;
        }

        .edit-form label {
            font-size: 13px;
            font-weight: 600;
        }

        .edit-form input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #777;
            border-radius: 5px;
            background: #303030;
            color: white;
            font-family: Montserrat, sans-serif;
        }

        .edit-form button {
            margin-top: 15px;
        }

        #edit-error {
            color: #ff7777;
            font-size: 13px;
        }

        /* Всплывающее окно с информацией о пластинке */
        .vinyl-info-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 10000;
            background: rgba(0, 0, 0, 0.82);
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .vinyl-info-overlay.active {
            display: flex;
        }

        .vinyl-info-box {
            position: relative;
            width: 100%;
            max-width: 390px;
            padding: 30px;
            background: #202020;
            color: #f5eee3;
            border: 1px solid #d4a65a;
            border-radius: 12px;
            box-sizing: border-box;
            font-family: Montserrat, sans-serif;
        }

        .vinyl-info-box h2 {
            margin: 5px 30px 20px 0;
            color: #d4a65a;
            font-family: "Playfair Display", serif;
        }

        .vinyl-info-box p {
            margin: 12px 0;
            line-height: 1.5;
        }

        .vinyl-info-box p span {
            color: #d4a65a;
        }

        .vinyl-info-box h3 {
            margin: 22px 0 0;
            color: #d4a65a;
        }

        .vinyl-info-close {
            position: absolute;
            top: 10px;
            right: 14px;
            border: 0;
            background: transparent;
            color: white;
            font-size: 30px;
            cursor: pointer;
        }

        .card {
            cursor: pointer;
        }

        .fav-btn,
        .admin-actions,
        .admin-actions button {
            cursor: pointer;
        }
    </style>
</head>

<body>

<header class="header">
    <div class="logo">
        <span class="logo-title">VINYL STORE</span>
        <span class="logo-subtitle">
            ✦ РАРИТЕТНЫЙ АНАЛОГОВЫЙ ЗВУК ✦
        </span>
    </div>

    <nav class="nav">
        <% if (isAdmin) { %>
            <a href="/add" class="cart-btn">
                Добавить пластинку
            </a>

            <form action="/logout" method="POST">
                <button class="cart-btn" type="submit">
                    Выйти
                </button>
            </form>
        <% } else { %>
            <a href="/login" class="cart-btn">
                Вход администратора
            </a>
        <% } %>

        <button class="cart-btn" id="open-cart-btn">
            <span>Корзина</span>
            <span id="cart-count" class="cart-badge">0</span>
        </button>
    </nav>
</header>

<section class="about-section">
    <div class="banner-card">
        <h2>Коллекция раритетного винила</h2>
        <p>
            Добро пожаловать в место с историей.
            Каждая пластинка в нашей коллекции —
            это оригинальное издание с неповторимым
            тёплым ламповым звучанием.
        </p>
    </div>

    <div class="banner-card">
        <div class="banner-badge">
            Акустический знак качества
        </div>
        <p>
            Все экземпляры промываются в ультразвуковых
            ванночках и тестируются на проигрывателях
            Hi-Fi класса перед выставлением в каталог.
        </p>
    </div>
</section>

<main class="catalog">
    <div class="section-header">
        <h2 class="genre-title">
            КОЛЛЕКЦИОННЫЕ ИЗДАНИЯ
        </h2>
        <div class="divider-line"></div>
    </div>

    <div class="card-grid">
        <% items.forEach(item => { %>

            <div class="card"
                 data-id="<%= item.id %>"
                 data-title="<%= item.title %>"
                 data-artist="<%= item.artist %>"
                 data-price="<%= item.price %>"
                 data-year="<%= item.year %>"
                 data-genre="<%= item.genre || '' %>"
                 data-condition="<%= item.condition || '' %>">

                <div class="album-sleeve">
                    <div class="vinyl-record">
                        <div class="grooves ring-1"></div>
                        <div class="grooves ring-2"></div>
                        <div class="grooves ring-3"></div>

                        <div class="label"
                             style="--label-color: #d9383a;">
                            <div class="center-hole"></div>
                        </div>
                    </div>

                    <button class="fav-btn"
                            type="button"
                            aria-label="Добавить в корзину">
                        <svg class="heart-icon" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        </svg>
                    </button>
                </div>

                <div class="card-info">
                    <h3 class="title">
                        <%= item.title %>
                    </h3>

                    <div class="artist">
                        <%= item.artist %>
                    </div>

                    <div class="vinyl-meta">
                        <span class="meta-tag">
                            <%= item.year %>
                        </span>
                        <span class="meta-tag condition">
                            <%= item.condition %>
                        </span>
                    </div>

                    <div class="price">
                        <%= item.price.toLocaleString("ru-RU") %>
                        <small>тг</small>
                    </div>

                    <% if (isAdmin) { %>
                        <div class="admin-actions">
                            <button type="button"
                                    class="admin-edit"
                                    data-id="<%= item.id %>">
                                Изменить
                            </button>

                            <button type="button"
                                    class="admin-delete"
                                    data-id="<%= item.id %>">
                                Удалить
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

        <% }) %>
    </div>
</main>

<!-- ИНФОРМАЦИЯ О ПЛАСТИНКЕ -->
<div class="vinyl-info-overlay" id="vinyl-info-modal">
    <div class="vinyl-info-box" role="dialog" aria-modal="true" aria-labelledby="vinyl-info-title">
        <button type="button"
                class="vinyl-info-close"
                id="close-vinyl-info"
                aria-label="Закрыть">&times;</button>

        <h2 id="vinyl-info-title"></h2>
        <p>Исполнитель: <span id="vinyl-info-artist"></span></p>
        <p>Год выпуска: <span id="vinyl-info-year"></span></p>
        <p>Жанр: <span id="vinyl-info-genre"></span></p>
        <p>Состояние: <span id="vinyl-info-condition"></span></p>
        <h3 id="vinyl-info-price"></h3>
    </div>
</div>

<!-- КОРЗИНА -->
<div class="modal-overlay" id="cart-modal">
    <div class="modal-window">
        <div class="modal-header">
            <h2>Ваша коллекция (Корзина)</h2>
            <button class="close-btn" id="close-cart" type="button">
                &times;
            </button>
        </div>

        <div class="cart-items" id="cart-items-container"></div>

        <div class="cart-footer">
            <div class="total-price">
                Итого: <span id="cart-total">0 тг</span>
            </div>

            <button class="btn-primary" id="go-to-checkout" type="button">
                Оформить заказ
            </button>
        </div>
    </div>
</div>

<!-- ОФОРМЛЕНИЕ ЗАКАЗА -->
<div class="modal-overlay" id="checkout-modal">
    <div class="modal-window checkout-window">
        <div class="modal-header">
            <h2>Доставка пластинок</h2>
            <button class="close-btn" id="close-checkout" type="button">
                &times;
            </button>
        </div>

        <form id="order-form" class="checkout-form">
            <div class="form-grid">
                <div class="form-group">
                    <label>Ваше Имя</label>
                    <input type="text" required placeholder="Алмас">
                </div>

                <div class="form-group">
                    <label>Телефон</label>
                    <input type="tel" required
                           placeholder="+7 (700) 000-00-00">
                </div>
            </div>

            <div class="form-group full-width">
                <label>Адрес доставки</label>
                <input type="text" required
                       placeholder="г. Астана, ул. Достык, 1">
            </div>

            <div class="checkout-footer">
                <button type="button"
                        class="btn-secondary"
                        id="back-to-cart">
                    Назад
                </button>

                <div class="total-price">
                    К оплате:
                    <span id="checkout-total">0 тг</span>
                </div>

                <button type="submit" class="btn-primary">
                    Подтвердить заказ
                </button>
            </div>
        </form>
    </div>
</div>

<!-- РЕДАКТИРОВАНИЕ -->
<% if (isAdmin) { %>

<div id="edit-modal" style="display:none;">
    <div class="modal-window">
        <div class="modal-header">
            <h2>Редактировать пластинку</h2>
            <button type="button"
                    class="close-btn"
                    id="close-edit">
                &times;
            </button>
        </div>

        <form id="edit-form" class="edit-form">
            <input type="hidden" id="edit-id">

            <label for="edit-title">Название</label>
            <input id="edit-title" type="text" required>

            <label for="edit-artist">Исполнитель</label>
            <input id="edit-artist" type="text" required>

            <label for="edit-year">Год</label>
            <input id="edit-year" type="number"
                   min="1" required>

            <label for="edit-price">Цена</label>
            <input id="edit-price" type="number"
                   min="0" required>

            <label for="edit-condition">Состояние</label>
            <input id="edit-condition" type="text">

            <label for="edit-genre">Жанр</label>
            <input id="edit-genre" type="text" required>

            <p id="edit-error" role="alert"></p>

            <button class="btn-primary" type="submit">
                Сохранить изменения
            </button>
        </form>
    </div>
</div>

<% } %>

<script src="/script.js"></script>

<% if (isAdmin) { %>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("edit-modal");
    const form = document.getElementById("edit-form");
    const errorText = document.getElementById("edit-error");

    function field(name) {
        return document.getElementById("edit-" + name);
    }

    // Открыть форму редактирования
    document.querySelectorAll(".admin-edit").forEach(button => {
        button.addEventListener("click", async () => {
            const id = button.dataset.id;

            try {
                const response = await fetch(
                    `/items/${id}`,
                    { credentials: "same-origin" }
                );

                if (!response.ok) {
                    throw new Error("Не удалось загрузить пластинку");
                }

                const item = await response.json();

                field("id").value = item.id;
                field("title").value = item.title;
                field("artist").value = item.artist;
                field("year").value = item.year;
                field("price").value = item.price;
                field("condition").value = item.condition || "";
                field("genre").value = item.genre || "";

                errorText.textContent = "";
                modal.style.display = "flex";

            } catch (error) {
                alert(error.message);
            }
        });
    });

    // Закрыть форму
    document.getElementById("close-edit")
        .addEventListener("click", () => {
            modal.style.display = "none";
        });

    // Сохранить изменения через PUT
    form.addEventListener("submit", async event => {
        event.preventDefault();

        const id = field("id").value;

        const data = {
            title: field("title").value,
            artist: field("artist").value,
            year: Number(field("year").value),
            price: Number(field("price").value),
            condition: field("condition").value,
            genre: field("genre").value
        };

        try {
            const response = await fetch(`/items/${id}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(
                    result.error || "Ошибка редактирования"
                );
            }

            alert("Пластинка успешно обновлена!");
            window.location.reload();

        } catch (error) {
            errorText.textContent = error.message;
        }
    });

    // Удаление через DELETE
    document.querySelectorAll(".admin-delete").forEach(button => {
        button.addEventListener("click", async () => {
            const id = button.dataset.id;

            if (!confirm("Удалить эту пластинку?")) {
                return;
            }

            try {
                const response = await fetch(`/items/${id}`, {
                    method: "DELETE",
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    let message = "Ошибка удаления";

                    try {
                        const result = await response.json();
                        message = result.error || message;
                    } catch (e) {}

                    throw new Error(message);
                }

                alert("Пластинка успешно удалена!");
                window.location.reload();

            } catch (error) {
                alert(error.message);
            }
        });
    });
});
</script>
<% } %>

</body>
</html>
